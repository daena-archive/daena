{
  "manifestVersion": 1,
  "id": "daena.writing",
  "name": "Writing Studio",
  "version": "0.1.0",
  "publisher": "daena-archive",
  "hostApi": ">=1.0.0 <2.0.0",
  "kind": "declarative",
  "entrypoints": { "ui": "dist/ui/index.html" },
  "capabilities": [
    "entity.read",
    "entity.write",
    "entity.delete",
    "document.read",
    "document.write",
    "field.read:self",
    "field.write:self",
    "relationship.read",
    "relationship.write",
    "asset.read:self",
    "asset.register",
    "search.query",
    "schema.overlay",
    "service.call:daena.maps/navigation"
  ],
  "dependencies": {
    "daena.lore": {
      "version": ">=0.1.0 <1.0.0",
      "required": false
    }
  },
  "namespaces": ["writing"],
  "schemas": [
    {
      "namespace": "writing",
      "entityTypes": [
        { "id": "manuscript", "name": "Manuscript", "icon": { "kind": "catalog", "id": "manuscript" }, "iconColor": { "kind": "preset", "id": "ink" } },
        { "id": "reference-page", "name": "Reference page", "icon": { "kind": "catalog", "id": "reference" }, "iconColor": { "kind": "preset", "id": "slate" } }
      ],
      "fields": [
        {
          "key": "status",
          "label": "Status",
          "type": "enum",
          "options": ["idea", "drafting", "revising", "complete"],
          "entityTypes": ["manuscript"]
        },
        { "key": "genre", "label": "Genre", "type": "text", "entityTypes": ["manuscript"] },
        { "key": "synopsis", "label": "Synopsis", "type": "text", "entityTypes": ["manuscript"] },
        {
          "key": "parent",
          "label": "Parent",
          "type": "relationship",
          "relationshipType": "part_of",
          "relationshipDirection": "outgoing",
          "entityTypes": ["manuscript"],
          "targetEntityTypes": ["manuscript"],
          "cardinality": "one",
          "relationshipConstraints": {
            "allowSelf": false,
            "acyclic": true,
            "unique": "directed"
          },
          "metadataFields": [{ "key": "order", "label": "Order", "type": "number" }]
        },
        {
          "key": "contents",
          "label": "Contents",
          "type": "relationship",
          "relationshipType": "part_of",
          "relationshipDirection": "incoming",
          "entityTypes": ["manuscript"],
          "targetEntityTypes": ["manuscript"],
          "cardinality": "many",
          "relationshipConstraints": {
            "allowSelf": false,
            "acyclic": true,
            "unique": "directed"
          },
          "metadataFields": [{ "key": "order", "label": "Order", "type": "number" }]
        },
        {
          "key": "revises",
          "label": "Revises",
          "type": "relationship",
          "relationshipType": "revises",
          "relationshipDirection": "outgoing",
          "entityTypes": ["manuscript"],
          "targetEntityTypes": ["manuscript"],
          "cardinality": "one",
          "relationshipConstraints": {
            "allowSelf": false,
            "acyclic": true,
            "unique": "directed"
          },
          "metadataFields": [{ "key": "notes", "label": "Notes", "type": "text" }]
        },
        {
          "key": "revisions",
          "label": "Revisions",
          "type": "relationship",
          "relationshipType": "revises",
          "relationshipDirection": "incoming",
          "entityTypes": ["manuscript"],
          "targetEntityTypes": ["manuscript"],
          "cardinality": "many",
          "relationshipConstraints": {
            "allowSelf": false,
            "acyclic": true,
            "unique": "directed"
          },
          "metadataFields": [{ "key": "notes", "label": "Notes", "type": "text" }]
        },
        {
          "key": "features",
          "label": "World",
          "type": "relationship",
          "relationshipType": "features",
          "relationshipDirection": "outgoing",
          "entityTypes": ["manuscript"],
          "targetEntityTypes": [
            "daena.lore:person",
            "daena.lore:place",
            "daena.lore:faction",
            "daena.lore:artifact",
            "daena.lore:culture",
            "daena.lore:concept"
          ],
          "cardinality": "many",
          "relationshipConstraints": {
            "allowSelf": false,
            "acyclic": false,
            "unique": "directed"
          },
          "metadataFields": [
            {
              "key": "role",
              "label": "Role",
              "type": "enum",
              "options": ["character", "setting", "object", "faction", "idea", "other"]
            },
            { "key": "notes", "label": "Notes", "type": "text" }
          ]
        },
        {
          "key": "appearances",
          "label": "Appearances",
          "type": "relationship",
          "relationshipType": "features",
          "relationshipDirection": "incoming",
          "entityTypes": [
            "daena.lore:person",
            "daena.lore:place",
            "daena.lore:faction",
            "daena.lore:artifact",
            "daena.lore:culture",
            "daena.lore:concept"
          ],
          "targetEntityTypes": ["manuscript"],
          "cardinality": "many",
          "relationshipConstraints": {
            "allowSelf": false,
            "acyclic": false,
            "unique": "directed"
          },
          "metadataFields": [
            {
              "key": "role",
              "label": "Role",
              "type": "enum",
              "options": ["character", "setting", "object", "faction", "idea", "other"]
            },
            { "key": "notes", "label": "Notes", "type": "text" }
          ]
        },
        {
          "key": "category",
          "label": "Category",
          "type": "enum",
          "options": ["setting", "character", "plot", "research", "other"],
          "entityTypes": ["reference-page"]
        },
        { "key": "aliases", "label": "Aliases", "type": "text", "entityTypes": ["reference-page"] }
      ]
    }
  ],
  "templates": [
    {
      "id": "manuscript",
      "name": "Manuscript",
      "entityType": "manuscript",
      "description": "A long-form story, essay, or other work in progress.",
      "fields": { "status": "idea", "genre": "", "synopsis": "" },
      "document": ""
    },
    {
      "id": "reference-page",
      "name": "Reference page",
      "entityType": "reference-page",
      "description": "A freeform wiki page for ideas, research, and world notes.",
      "fields": { "category": "other", "aliases": "" },
      "document": ""
    }
  ],
  "views": [],
  "commands": [
    {
      "id": "show-on-map",
      "title": "Show reference on map",
      "action": { "type": "refresh-view" },
      "exposure": ["view"]
    }
  ],
  "services": { "provides": [], "consumes": [{ "name": "daena.maps/navigation", "major": 1 }] },
  "events": { "publishes": [], "subscribes": [] },
  "migrations": [
    {
      "id": "writing-v1",
      "from": 0,
      "to": 1,
      "recovery": "backup",
      "operations": [{ "kind": "create-namespace", "namespace": "writing" }]
    }
  ]
}
