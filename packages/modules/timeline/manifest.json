{
  "manifestVersion": 1,
  "id": "daena.timeline",
  "name": "Timeline",
  "version": "0.1.0",
  "publisher": "daena-archive",
  "hostApi": ">=1.0.0 <2.0.0",
  "kind": "sandboxed",
  "entrypoints": { "ui": "dist/ui/index.html", "wasm": "dist/service.wasm" },
  "capabilities": ["entity.read", "entity.write", "entity.delete", "document.read", "document.write", "field.read:self", "field.read:shared", "field.write:self", "relationship.read", "relationship.write", "asset.read:self", "asset.register", "search.query", "schema.overlay", "service.provide:daena.timeline.resolve-date@1", "service.call:daena.maps/navigation"],
  "dependencies": {},
  "namespaces": ["timeline"],
  "schemas": [{
    "namespace": "timeline",
    "entityTypes": ["event", "encounter"],
    "fields": [
      { "key": "startsAt", "label": "Starts", "type": "date", "required": false, "entityTypes": ["event", "encounter"] },
      { "key": "endsAt", "label": "Ends", "type": "date", "entityTypes": ["event", "encounter"] },
      { "key": "location", "label": "Location", "type": "relationship", "relationshipType": "occurred_at", "targetEntityTypes": ["place"], "entityTypes": ["encounter"] },
      { "key": "participants", "label": "Participants", "type": "relationship", "relationshipType": "involves", "targetEntityTypes": ["person"], "entityTypes": ["encounter"] }
    ]
  }],
  "templates": [
    { "id": "event", "name": "Timeline event", "entityType": "event", "description": "A moment, turning point, or span of history.", "icon": "E", "fields": { "startsAt": "", "endsAt": "" } },
    { "id": "encounter", "name": "Encounter", "entityType": "encounter", "description": "A meeting or interaction between people at a place and time.", "icon": "X", "fields": { "startsAt": "", "endsAt": "", "location": [], "participants": [] } }
  ],
  "views": [],
  "commands": [{ "id": "show-on-map", "title": "Show event on map", "action": { "type": "refresh-view" }, "exposure": ["view"] }],
  "services": { "provides": [{ "name": "daena.timeline.resolve-date", "major": 1 }], "consumes": [{ "name": "daena.maps/navigation", "major": 1 }] },
  "events": { "publishes": [], "subscribes": [] },
  "migrations": [{ "id": "timeline-v1", "from": 0, "to": 1, "recovery": "backup", "operations": [{ "kind": "create-namespace", "namespace": "timeline" }] }]
}
