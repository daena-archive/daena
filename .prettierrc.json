{
  "plugins": ["prettier-plugin-svelte"],
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSameLine": true,
  "singleAttributePerLine": false,
  "svelteIndentScriptAndStyle": false,
  "svelteSortOrder": "scripts-markup-styles-options"
}
