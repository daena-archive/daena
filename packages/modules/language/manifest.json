{
  "manifestVersion": 1,
  "id": "daena.language",
  "name": "Language",
  "version": "0.1.0",
  "publisher": "daena-archive",
  "hostApi": ">=1.0.0 <2.0.0",
  "kind": "sandboxed",
  "entrypoints": { "ui": "dist/ui/index.html" },
  "capabilities": ["entity.read", "entity.write", "document.read", "document.write", "field.read:self", "field.write:self", "record.read:self", "record.write:self"],
  "dependencies": {},
