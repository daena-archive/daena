{
  "name": "daena",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/modules/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,ts,svelte}\" \"src-tauri/**/*.{js,ts,svelte}\" \"packages/**/*.{js,ts,svelte}\" \"scripts/**/*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,svelte}\" \"packages/**/*.{js,ts,svelte}\" \"scripts/**/*.{js,mjs,ts}\"",
    "build:plugin-sdk": "tsc -p packages/plugin-sdk/tsconfig.json",
    "build:plugin-examples": "npm run build:plugin-sdk && node scripts/build-example-wasm.mjs",
    "prepare:maps": "node scripts/ensure-fmg-archive.mjs",
    "gen:plugin-contract": "node scripts/gen-plugin-contract.mjs",
    "gen:manifest-fixtures": "node scripts/gen-plugin-manifest-fixtures.mjs",
    "precheck:manifest-fixtures": "npm run gen:manifest-fixtures",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js && npm run check:plugin-contract",
    "check:plugin-contract": "node scripts/validate-plugin-contract.mjs && node scripts/check-plugin-contract-drift.mjs",
    "check:manifest-fixtures": "npm run build:plugin-sdk && node scripts/validate-manifest-fixtures.mjs && node scripts/check-manifest-fixtures-drift.mjs",
    "check:maps:native-vector": "node scripts/maps-native-vector.test.mjs && node --experimental-strip-types scripts/maps-field-persistence.test.mjs && node --experimental-strip-types scripts/maps-native-vector-editor.test.mjs",
    "check:maps:physical": "node scripts/maps-native-vector-provenance.test.mjs && node scripts/maps-physical.test.mjs && node scripts/maps-physical-surface.test.mjs",
    "check:maps:atlas": "node scripts/maps-atlas.test.mjs",
    "check:maps:physical-benchmark": "node scripts/maps-physical-benchmark.mjs",
    "check:plugin-isolation": "node scripts/check-plugin-isolation.mjs",
    "check:timeline-calendar": "node --experimental-strip-types scripts/timeline-calendar.test.mjs && node --experimental-strip-types scripts/timeline-projection.test.mjs && node --experimental-strip-types scripts/timeline-tabs.test.mjs && node --experimental-strip-types scripts/lore-timeline-relations.test.mjs && node scripts/timeline-ux.test.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:writing-tabs": "node --experimental-strip-types scripts/writing-tabs.test.mjs",
    "pretest:plugin-conformance": "npm run gen:manifest-fixtures",
    "test:plugin-conformance": "node scripts/plugin-conformance.mjs && node scripts/plugin-dual-validator.test.mjs",
    "test:plugin-declarative": "node scripts/plugin-declarative.test.mjs",
    "test:plugin-cli": "node scripts/plugin-cli.test.mjs",
    "test:plugin-transport": "node scripts/plugin-transport.test.mjs",
    "test:markdown": "node --experimental-strip-types scripts/markdown-fixtures.test.mjs && node --experimental-strip-types scripts/editor-roundtrip.test.mjs && node --experimental-strip-types scripts/git-diff-display.test.mjs",
    "test:git-ui": "node scripts/git-settings-ux.test.mjs",
    "test:beta-ux": "node --experimental-strip-types scripts/navigation-history.test.mjs && node scripts/beta-ux-foundation.test.mjs && node --experimental-strip-types scripts/quick-open.test.mjs && node scripts/workbench.test.mjs && node scripts/project-center.test.mjs && node scripts/beta-polish.test.mjs",
    "test:ai-stream": "node --experimental-strip-types scripts/ai-stream-state.test.mjs",
    "test:theme": "node --experimental-strip-types scripts/theme.test.mjs",
    "tauri": "tauri"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@lucide/svelte": "^1.32.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-image": "3.29.2",
    "cytoscape": "^3.34.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/extension-blockquote": "^3.29.2",
    "@tiptap/extension-bold": "^3.29.2",
    "@tiptap/extension-code": "^3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-document": "^3.29.2",
    "@tiptap/extension-heading": "^3.29.2",
    "@tiptap/extension-horizontal-rule": "^3.29.2",
    "@tiptap/extension-hard-break": "3.29.2",
    "@tiptap/extension-italic": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-paragraph": "^3.29.2",
    "@tiptap/extension-strike": "^3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "hast-util-to-mdast": "^10.1.2",
    "mdast-util-to-markdown": "^2.1.2",
    "maplibre-gl": "^5.24.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "terra-draw": "^1.32.3",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "tiptap-text-direction": "^0.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "uuid": "^14.0.1",
    "vis-timeline": "^8.5.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "@tauri-apps/cli": "^2"
  }
}
