{
  "manifestVersion": 1,
  "id": "daena.timeline",
  "name": "Timeline",
  "version": "0.1.0",
  "publisher": "daena-archive",
  "hostApi": ">=1.0.0 <2.0.0",
  "kind": "sandboxed",
  "entrypoints": { "ui": "dist/ui/index.html", "wasm": "dist/service.wasm" },
  "capabilities": [
    "entity.read",
    "entity.write",
    "entity.delete",
    "document.read",
    "document.write",
    "field.read:self",
    "field.read:shared",
    "field.write:self",
    "record.read:self",
    "record.write:self",
    "relationship.read",
    "relationship.write",
    "asset.read:self",
    "asset.register",
    "search.query",
    "schema.overlay",
    "service.provide:daena.timeline.resolve-date@1",
    "service.call:daena.maps/navigation"
  ],
  "dependencies": {},
  "namespaces": ["timeline"],
  "schemas": [
    {
      "namespace": "timeline",
      "entityTypes": [
        {
          "id": "event",
          "name": "Timeline event",
          "icon": { "kind": "catalog", "id": "event" },
          "iconColor": { "kind": "preset", "id": "amber" }
        },
        {
          "id": "encounter",
          "name": "Encounter",
          "icon": { "kind": "catalog", "id": "encounter" },
          "iconColor": { "kind": "preset", "id": "ember" }
        },
        {
          "id": "era",
          "name": "Era",
          "icon": { "kind": "catalog", "id": "era" },
          "iconColor": { "kind": "preset", "id": "pine" }
        },
        {
          "id": "calendar",
          "name": "Calendar",
          "icon": { "kind": "catalog", "id": "calendar" },
          "iconColor": { "kind": "preset", "id": "brass" }
        }
      ],
      "fields": [
        {
          "key": "startsAt",
          "label": "Starts",
          "type": "date",
          "required": false,
          "entityTypes": ["event", "encounter", "era"]
        },
        { "key": "endsAt", "label": "Ends", "type": "date", "entityTypes": ["event", "encounter", "era"] },
        { "key": "description", "label": "Description", "type": "text", "entityTypes": ["calendar", "era"] },
        {
          "key": "era",
          "label": "Era",
          "type": "relationship",
          "relationshipType": "during",
          "targetEntityTypes": ["era"],
          "entityTypes": ["event", "encounter"]
        },
        {
          "key": "calendar",
          "label": "Calendar",
          "type": "relationship",
          "relationshipType": "uses_calendar",
          "targetEntityTypes": ["calendar"],
          "entityTypes": ["era"]
        },
        {
          "key": "location",
          "label": "Location",
          "type": "relationship",
          "relationshipType": "occurred_at",
          "targetEntityTypes": ["daena.lore:place"],
          "entityTypes": ["encounter"],
          "metadataFields": [
            { "key": "significance", "label": "Significance", "type": "enum", "options": ["central", "peripheral"] }
          ]
        },
        {
          "key": "participants",
          "label": "Participants",
          "type": "relationship",
          "relationshipType": "involves",
          "targetEntityTypes": ["daena.lore:person"],
          "entityTypes": ["encounter"],
          "metadataFields": [
            {
              "key": "role",
              "label": "Role",
              "type": "enum",
              "options": ["protagonist", "participant", "witness", "instigator"]
            },
            { "key": "outcome", "label": "Outcome", "type": "enum", "options": ["survived", "perished", "absent"] }
          ]
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "event",
      "name": "Timeline event",
      "entityType": "event",
      "description": "A moment, turning point, or span of history.",
      "fields": { "startsAt": "", "endsAt": "", "era": [] }
    },
    {
      "id": "encounter",
      "name": "Encounter",
      "entityType": "encounter",
      "description": "A meeting or interaction between people at a place and time.",
      "fields": { "startsAt": "", "endsAt": "", "location": [], "participants": [], "era": [] }
    },
    {
      "id": "era",
      "name": "Era",
      "entityType": "era",
      "description": "A named period of Timeline history.",
      "fields": { "startsAt": "", "endsAt": "", "description": "", "calendar": [] }
    },
    {
      "id": "calendar",
      "name": "Calendar",
      "entityType": "calendar",
      "description": "A way this world names and divides time. Leave it empty to keep using Gregorian dates.",
      "fields": { "description": "" }
    }
  ],
  "records": [
    {
      "id": "calendar-definition",
      "ownerEntityTypes": ["calendar"],
      "schema": {
        "type": "object",
        "properties": {
          "schemaVersion": { "type": "number" },
          "startingYear": { "type": "number" },
          "epoch": { "type": "object" },
          "dateFormat": { "type": "string" },
          "months": { "type": "array" },
          "weekdays": { "type": "array" },
          "seasons": { "type": "array" },
          "allowNegativeYears": { "type": "boolean" },
          "eraLabels": { "type": "object" }
        },
        "required": ["schemaVersion"],
        "additionalProperties": false
      }
    }
  ],
  "views": [],
  "commands": [
    { "id": "show-on-map", "title": "Show event on map", "action": { "type": "refresh-view" }, "exposure": ["view"] }
  ],
  "services": {
    "provides": [{ "name": "daena.timeline.resolve-date", "major": 1 }],
    "consumes": [{ "name": "daena.maps/navigation", "major": 1 }]
  },
  "events": { "publishes": [], "subscribes": [] },
  "migrations": [
    {
      "id": "timeline-v1",
      "from": 0,
      "to": 1,
      "recovery": "backup",
      "operations": [{ "kind": "create-namespace", "namespace": "timeline" }]
    }
  ]
}
