{
  "$defs": {
    "Command": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/CommandAction"
        },
        "capabilities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "exposure": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CommandExposure"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "CommandAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "refresh-view"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "CommandExposure": {
      "enum": [
        "view",
        "broker"
      ],
      "type": "string"
    },
    "CommandProperty": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/CommandValueType"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "CommandSchema": {
      "additionalProperties": false,
      "properties": {
        "additionalProperties": {
          "default": true,
          "type": "boolean"
        },
        "properties": {
          "additionalProperties": {
            "$ref": "#/$defs/CommandProperty"
          },
          "default": {},
          "type": "object"
        },
        "required": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "type": {
          "const": "object"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "CommandValueType": {
      "enum": [
        "object",
        "string",
        "number",
        "boolean",
        "array",
        "null"
      ],
      "type": "string"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "required",
        "version"
      ],
      "type": "object"
    },
    "EntityTemplate": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "document": {
          "type": [
            "string",
            "null"
          ]
        },
        "entityType": {
          "minLength": 1,
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "requiredFields": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "entityType",
        "fields",
        "id",
        "name"
      ],
      "type": "object"
    },
    "EntityTypeColor": {
      "description": "Curated entity-type colors. Preset IDs are owned by Daena; custom colors require explicit light and dark foreground hex values.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": [
                "brass",
                "copper",
                "ember",
                "moss",
                "pine",
                "ocean",
                "sky",
                "frost",
                "amber",
                "gold",
                "sand",
                "rose",
                "plum",
                "violet",
                "slate",
                "ink"
              ],
              "type": "string"
            },
            "kind": {
              "enum": [
                "preset"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dark": {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "kind": {
              "enum": [
                "custom"
              ],
              "type": "string"
            },
            "light": {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            }
          },
          "required": [
            "dark",
            "kind",
            "light"
          ],
          "type": "object"
        }
      ]
    },
    "EntityTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "icon": {
          "$ref": "#/$defs/IconRef"
        },
        "iconColor": {
          "$ref": "#/$defs/EntityTypeColor"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "icon",
        "iconColor",
        "id",
        "name"
      ],
      "type": "object"
    },
    "Entrypoints": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ui": {
          "$ref": "#/$defs/packagePath"
        },
        "wasm": {
          "$ref": "#/$defs/packagePath"
        }
      },
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/serviceName"
        },
        "version": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Events": {
      "additionalProperties": false,
      "properties": {
        "publishes": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "subscribes": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "publishes",
        "subscribes"
      ],
      "type": "object"
    },
    "FieldDefinition": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "enum": [
            "one",
            "many"
          ],
          "type": "string"
        },
        "entityTypes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "key": {
          "pattern": "^[a-z][a-zA-Z0-9_]*$",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "metadataFields": {
          "items": {
            "$ref": "#/$defs/MetadataFieldDefinition"
          },
          "type": "array"
        },
        "multiple": {
          "default": false,
          "description": "An enum field with multiple enabled values is stored as a string array.",
          "type": "boolean"
        },
        "oneOf": {
          "items": {
            "$ref": "#/$defs/OneOfVariant"
          },
          "type": "array"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true
        },
        "relationshipType": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "shared": {
          "default": false,
          "description": "A shared field can be read by other plugins with `field.read:shared`, but remains writable only by the namespace owner.",
          "type": "boolean"
        },
        "targetEntityTypes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "timeline": {
          "$ref": "#/$defs/TimelineFieldContribution"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "enum",
            "oneof",
            "relationship"
          ]
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "type": "object"
    },
    "IconRef": {
      "description": "Stable, renderer-neutral icon references used by entity types and templates. Catalog IDs are owned by Daena; plugin SVG paths are resolved relative to the verified package that declares them; user SVGs are stored in project overlays.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": [
                "agriculture",
                "anchor",
                "animal",
                "art",
                "artifact",
                "bird",
                "calendar",
                "camp",
                "castle",
                "collection",
                "compass",
                "concept",
                "craft",
                "crown",
                "culture",
                "danger",
                "encounter",
                "era",
                "event",
                "faction",
                "fire",
                "fish",
                "flower",
                "forest",
                "group",
                "heart",
                "home",
                "ice",
                "insect",
                "key",
                "language",
                "library",
                "lock",
                "magic",
                "manuscript",
                "map",
                "mine",
                "moon",
                "mountain",
                "music",
                "object",
                "person",
                "place",
                "plant",
                "reference",
                "science",
                "scroll",
                "settlement",
                "ship",
                "spirit",
                "star",
                "storm",
                "sun",
                "theatre",
                "unknown",
                "wand",
                "wealth"
              ],
              "type": "string"
            },
            "kind": {
              "enum": [
                "catalog"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "plugin-svg"
              ],
              "type": "string"
            },
            "path": {
              "minLength": 5,
              "pattern": "^[^\\\\/](?:[^\\\\]*\\/)*[^\\\\/]+\\.[sS][vV][gG]$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "user-svg"
              ],
              "type": "string"
            },
            "svg": {
              "maxLength": 32768,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "svg"
          ],
          "type": "object"
        }
      ]
    },
    "MetadataFieldDefinition": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z][a-zA-Z0-9_]*$",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "oneOf": {
          "items": {
            "$ref": "#/$defs/OneOfVariant"
          },
          "type": "array"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "enum",
            "oneof"
          ]
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "type": "object"
    },
    "Migration": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/MigrationOperation"
          },
          "type": "array"
        },
        "recovery": {
          "enum": [
            "backup",
            "preserve-data"
          ]
        },
        "to": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "from",
        "id",
        "operations",
        "recovery",
        "to"
      ],
      "type": "object"
    },
    "MigrationOperation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "create-namespace"
              ],
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/namespace"
            }
          },
          "required": [
            "kind",
            "namespace"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/FieldDefinition"
            },
            "kind": {
              "enum": [
                "add-field"
              ],
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/namespace"
            }
          },
          "required": [
            "field",
            "kind",
            "namespace"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "rename-field"
              ],
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/namespace"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "kind",
            "namespace",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "drop-field"
              ],
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/namespace"
            }
          },
          "required": [
            "key",
            "kind",
            "namespace"
          ],
          "type": "object"
        }
      ]
    },
    "OneOfVariant": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "enum",
            "oneof",
            "relationship"
          ]
        }
      },
      "required": [
        "label",
        "type"
      ],
      "type": "object"
    },
    "PluginKind": {
      "enum": [
        "declarative",
        "sandboxed"
      ],
      "type": "string"
    },
    "PluginManifest": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/Command"
          },
          "type": "array"
        },
        "dependencies": {
          "additionalProperties": {
            "$ref": "#/$defs/Dependency"
          },
          "type": "object"
        },
        "enabledByDefault": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "entrypoints": {
          "$ref": "#/$defs/Entrypoints"
        },
        "events": {
          "$ref": "#/$defs/Events"
        },
        "hostApi": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PluginKind"
        },
        "manifestVersion": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "migrations": {
          "items": {
            "$ref": "#/$defs/Migration"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "namespaces": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "publisher": {
          "type": "string"
        },
        "records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordCollection"
          },
          "type": "array"
        },
        "schemas": {
          "items": {
            "$ref": "#/$defs/SchemaContribution"
          },
          "type": "array"
        },
        "services": {
          "$ref": "#/$defs/Services"
        },
        "stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginStability"
            },
            {
              "type": "null"
            }
          ]
        },
        "templates": {
          "items": {
            "$ref": "#/$defs/EntityTemplate"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/View"
          },
          "type": "array"
        }
      },
      "required": [
        "capabilities",
        "commands",
        "dependencies",
        "entrypoints",
        "events",
        "hostApi",
        "id",
        "kind",
        "manifestVersion",
        "migrations",
        "name",
        "namespaces",
        "publisher",
        "schemas",
        "services",
        "templates",
        "version",
        "views"
      ],
      "type": "object"
    },
    "PluginStability": {
      "enum": [
        "stable",
        "beta",
        "experimental"
      ],
      "type": "string"
    },
    "RecordCollection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "ownerEntityTypes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema": {
          "$ref": "#/$defs/CommandSchema"
        }
      },
      "required": [
        "id",
        "ownerEntityTypes",
        "schema"
      ],
      "type": "object"
    },
    "SchemaContribution": {
      "additionalProperties": false,
      "properties": {
        "entityTypes": {
          "items": {
            "$ref": "#/$defs/EntityTypeDefinition"
          },
          "type": "array",
          "uniqueItems": true
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDefinition"
          },
          "type": "array"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        }
      },
      "required": [
        "entityTypes",
        "fields",
        "namespace"
      ],
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "$ref": "#/$defs/serviceName"
        }
      },
      "required": [
        "major",
        "name"
      ],
      "type": "object"
    },
    "Services": {
      "additionalProperties": false,
      "properties": {
        "consumes": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array"
        },
        "provides": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array"
        }
      },
      "required": [
        "consumes",
        "provides"
      ],
      "type": "object"
    },
    "TimelineFieldContribution": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "layer": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimelineFieldLayer"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/TimelineFieldRole"
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "TimelineFieldLayer": {
      "enum": [
        "dates",
        "lifelines"
      ],
      "type": "string"
    },
    "TimelineFieldRole": {
      "enum": [
        "point",
        "start",
        "end"
      ],
      "type": "string"
    },
    "View": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ViewComponent"
          },
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "renderer": {
          "$ref": "#/$defs/ViewRenderer",
          "default": {
            "type": "declarative"
          }
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "ViewComponent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "enum": [
                "heading"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "enum": [
                "text"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entityType": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "limit": {
              "format": "uint32",
