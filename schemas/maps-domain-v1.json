{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daena-archive/daena/schemas/maps-domain-v1.json",
  "title": "Daena Maps provider-neutral domain v1",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/map" },
    { "$ref": "#/$defs/locations" },
    { "$ref": "#/$defs/layers" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "point": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }], "items": false },
    "date": { "type": ["object", "null"], "additionalProperties": false, "properties": { "calendar": { "const": "gregorian" }, "era": { "enum": ["BCE", "CE"] }, "year": { "type": "integer" }, "month": { "type": "integer", "minimum": 1, "maximum": 12 }, "day": { "type": "integer", "minimum": 1, "maximum": 31 }, "precision": { "enum": ["year", "month", "day"] } } },
    "anchor": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "point"], "properties": { "kind": { "const": "point" }, "point": { "$ref": "#/$defs/point" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "provider", "featureKind", "featureId", "fallbackPoint"], "properties": { "kind": { "const": "provider-feature" }, "provider": { "const": "azgaar-fmg" }, "featureKind": { "enum": ["burg", "state", "province", "river", "marker"] }, "featureId": { "type": "string", "minLength": 1 }, "fallbackPoint": { "$ref": "#/$defs/point" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "points"], "properties": { "kind": { "const": "path" }, "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "rings"], "properties": { "kind": { "const": "area" }, "rings": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/point" } } } } }
    ] },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "provider", "sourceAssetId", "previewAssetId", "defaultView"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "provider": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["id", "adapterVersion", "sourceFormat"], "properties": { "id": { "const": "azgaar-fmg" }, "adapterVersion": { "const": 1 }, "sourceFormat": { "const": "fmg-map" } } },
            { "type": "object", "additionalProperties": false, "required": ["id", "adapterVersion", "sourceFormat"], "properties": { "id": { "const": "daena-image" }, "adapterVersion": { "const": 1 }, "sourceFormat": { "enum": ["png", "jpeg", "svg"] } } }
          ]
        },
        "sourceAssetId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "previewAssetId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "defaultView": { "type": "object", "additionalProperties": false, "required": ["center", "zoom"], "properties": { "center": { "$ref": "#/$defs/point" }, "zoom": { "type": "number", "exclusiveMinimum": 0 } } }
      },
      "if": { "properties": { "provider": { "properties": { "id": { "const": "daena-image" } }, "required": ["id"] } } },
      "then": { "properties": { "sourceAssetId": { "$ref": "#/$defs/uuid" } } }
    },
    "locations": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "locations"], "properties": { "schemaVersion": { "const": 1 }, "locations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "mapEntityId", "role", "label", "anchor", "validity"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "mapEntityId": { "$ref": "#/$defs/uuid" }, "role": { "type": "string", "minLength": 1, "maxLength": 128 }, "label": { "type": "string", "maxLength": 256 }, "anchor": { "$ref": "#/$defs/anchor" }, "validity": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" } } } } } } } },
    "semanticLayer": { "type": "object", "additionalProperties": false, "required": ["id", "name", "order", "defaultVisible", "style", "selector"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "order": { "type": "integer" }, "defaultVisible": { "type": "boolean" }, "style": { "type": "object" }, "selector": { "type": "object" } } },
    "rasterLayer": { "type": "object", "additionalProperties": false, "required": ["id", "name", "order", "defaultVisible", "style", "selector", "kind", "rasterAssetId", "opacity", "locked"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "order": { "type": "integer" }, "defaultVisible": { "type": "boolean" }, "style": { "type": "object", "additionalProperties": false, "properties": {} }, "selector": { "type": "object", "additionalProperties": false, "properties": {} }, "kind": { "const": "raster" }, "rasterAssetId": { "$ref": "#/$defs/uuid" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "locked": { "type": "boolean" } } },
    "layers": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "layers"], "properties": { "schemaVersion": { "const": 1 }, "layers": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/semanticLayer" }, { "$ref": "#/$defs/rasterLayer" }] } } } }
  }
}
