{
  "manifestVersion": 1,
  "id": "worldbuilder.lore",
  "name": "Lore",
  "version": "0.1.0",
  "publisher": "worldbuilder",
  "hostApi": ">=1.0.0 <2.0.0",
  "kind": "sandboxed",
  "entrypoints": { "ui": "dist/ui/index.html" },
  "capabilities": ["entity.read", "entity.write", "entity.delete", "document.read", "document.write", "field.read:self", "field.write:self", "relationship.read", "relationship.write", "asset.read:self", "asset.import", "search.query"],
  "dependencies": {},
  "namespaces": ["lore"],
  "schemas": [{
    "namespace": "lore",
    "entityTypes": ["person", "place", "faction", "artifact", "culture"],
    "fields": [
      { "key": "summary", "label": "Summary", "type": "text" },
      { "key": "aliases", "label": "Aliases", "type": "text" },
      { "key": "occupation", "label": "Occupation", "type": "text", "entityTypes": ["person"] },
      { "key": "origin", "label": "Origin", "type": "entity-ref", "entityTypes": ["person"] },
      { "key": "affiliation", "label": "Affiliation", "type": "entity-ref", "entityTypes": ["person"] },
      { "key": "region", "label": "Region", "type": "text", "entityTypes": ["place"] },
      { "key": "climate", "label": "Climate", "type": "text", "entityTypes": ["place"] },
      { "key": "population", "label": "Population", "type": "number", "entityTypes": ["place"] },
      { "key": "material", "label": "Material", "type": "text", "entityTypes": ["artifact"] },
      { "key": "creator", "label": "Creator", "type": "entity-ref", "entityTypes": ["artifact"] },
      { "key": "currentOwner", "label": "Current owner", "type": "entity-ref", "entityTypes": ["artifact"] },
      { "key": "goal", "label": "Goal", "type": "text", "entityTypes": ["faction"] },
      { "key": "leader", "label": "Leader", "type": "entity-ref", "entityTypes": ["faction"] },
      { "key": "headquarters", "label": "Headquarters", "type": "entity-ref", "entityTypes": ["faction"] },
      { "key": "values", "label": "Values", "type": "text", "entityTypes": ["culture"] },
      { "key": "language", "label": "Language", "type": "text", "entityTypes": ["culture"] },
      { "key": "homeland", "label": "Homeland", "type": "entity-ref", "entityTypes": ["culture"] }
    ]
  }],
  "templates": [
    { "id": "person", "name": "Person", "entityType": "person", "description": "A character with a history, voice, and place in the world.", "icon": "P", "requiredFields": ["occupation"], "fields": { "summary": "", "aliases": "", "occupation": "", "origin": "", "affiliation": "" } },
    { "id": "place", "name": "Place", "entityType": "place", "description": "A location, landmark, or region worth remembering.", "icon": "L", "requiredFields": ["region"], "fields": { "summary": "", "aliases": "", "region": "", "climate": "", "population": "" } },
    { "id": "artifact", "name": "Artifact", "entityType": "artifact", "description": "An object with meaning, history, or a story of its own.", "icon": "A", "requiredFields": ["material"], "fields": { "summary": "", "aliases": "", "material": "", "creator": "", "currentOwner": "" } },
    { "id": "faction", "name": "Faction", "entityType": "faction", "description": "A group, institution, or power with shared interests.", "icon": "F", "requiredFields": ["goal"], "fields": { "summary": "", "aliases": "", "goal": "", "leader": "", "headquarters": "" } },
    { "id": "culture", "name": "Culture", "entityType": "culture", "description": "A people, tradition, or way of life that shapes the world.", "icon": "C", "requiredFields": ["values"], "fields": { "summary": "", "aliases": "", "values": "", "language": "", "homeland": "" } }
  ],
  "views": [{ "id": "lore-entities", "title": "Lore Entries" }],
  "commands": [],
  "services": { "provides": [], "consumes": [] },
  "events": { "publishes": [], "subscribes": [] },
  "migrations": [{ "id": "lore-v1", "from": 0, "to": 1, "recovery": "backup", "operations": [{ "kind": "create-namespace", "namespace": "lore" }] }]
