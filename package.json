{
  "name": "daena",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/modules/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:plugin-contract",
    "check:plugin-contract": "node scripts/validate-plugin-contract.mjs && node scripts/check-plugin-contract-drift.mjs",
    "gen:plugin-contract": "node scripts/gen-plugin-contract.mjs",
    "gen:manifest-fixtures": "node scripts/gen-plugin-manifest-fixtures.mjs",
    "precheck:manifest-fixtures": "npm run gen:manifest-fixtures",
    "check:manifest-fixtures": "npm run build:plugin-sdk && node scripts/validate-manifest-fixtures.mjs && node scripts/check-manifest-fixtures-drift.mjs",
    "check:maps:phase0": "node scripts/fmg-phase0-check.mjs",
    "check:maps:phase1": "node scripts/maps-phase1-fixtures.test.mjs",
    "prepare:maps": "node scripts/ensure-fmg-archive.mjs",
    "check:plugin-isolation": "node scripts/check-plugin-isolation.mjs",
    "format": "prettier --write \"src/**/*.{js,ts,svelte}\" \"packages/**/*.{js,ts,svelte}\" \"scripts/**/*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,svelte}\" \"packages/**/*.{js,ts,svelte}\" \"scripts/**/*.{js,mjs,ts}\"",
    "build:plugin-sdk": "tsc -p packages/plugin-sdk/tsconfig.json",
    "build:plugin-examples": "npm run build:plugin-sdk && node scripts/build-example-wasm.mjs",
    "pretest:plugin-conformance": "npm run gen:manifest-fixtures",
    "test:plugin-conformance": "node scripts/plugin-conformance.mjs && node scripts/plugin-dual-validator.test.mjs",
    "test:plugin-declarative": "node scripts/plugin-declarative.test.mjs",
    "test:plugin-cli": "node scripts/plugin-cli.test.mjs",
    "test:plugin-transport": "node scripts/plugin-transport.test.mjs",
    "test:markdown": "node --experimental-strip-types scripts/markdown-fixtures.test.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "cytoscape": "^3.34.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-blockquote": "^3.29.2",
    "@tiptap/extension-bold": "^3.29.2",
    "@tiptap/extension-code": "^3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-document": "^3.29.2",
    "@tiptap/extension-heading": "^3.29.2",
    "@tiptap/extension-horizontal-rule": "^3.29.2",
    "@tiptap/extension-italic": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-paragraph": "^3.29.2",
    "@tiptap/extension-strike": "^3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "uuid": "^14.0.1",
    "vis-timeline": "^8.5.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "@tauri-apps/cli": "^2"
  }
}
