    {
      "id": "faction",
      "name": "Faction",
      "entityType": "faction",
      "description": "A group, institution, or power with shared interests.",
      "icon": "F",
      "requiredFields": [],
      "fields": {
        "summary": "",
        "aliases": "",
        "goal": "",
        "leader": [],
        "headquarters": [],
        "createdAt": "",
        "endedAt": ""
      }
    },
    {
      "id": "culture",
      "name": "Culture",
      "entityType": "culture",
      "description": "A people, tradition, or way of life that shapes the world.",
      "icon": "C",
      "requiredFields": [],
      "fields": {
        "summary": "",
        "aliases": "",
        "values": "",
