{
  "$id": "https://github.com/daena-archive/daena/schemas/plugin-error-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$",
      "type": "string"
    },
    "details": true,
    "message": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "title": "Daena Archive Plugin RPC Error v1",
  "type": "object"
}